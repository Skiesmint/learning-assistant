/* pages/error/index.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 错题重铸 */
.forge-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.original-question {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.question-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.question-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.error-analysis {
  border-top: 2rpx solid #eee;
  padding-top: 20rpx;
}

.analysis-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #FF5722;
  margin-bottom: 12rpx;
}

.analysis-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.transformed-questions {
  margin-top: 30rpx;
}

.transform-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.transform-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.transform-item {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.transform-type {
  font-size: 24rpx;
  color: #2196F3;
  margin-bottom: 12rpx;
}

.transform-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.transform-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.action-btn.solve {
  background: #2196F3;
  color: #fff;
}

.action-btn.hint {
  background: #E3F2FD;
  color: #2196F3;
}

/* 抗干扰训练 */
.interference-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.training-question {
  margin-bottom: 30rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.option-item {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.option-item.selected {
  background: #E3F2FD;
  border: 2rpx solid #2196F3;
}

.option-item.correct {
  background: #E8F5E9;
  border: 2rpx solid #4CAF50;
}

.option-item.wrong {
  background: #FFEBEE;
  border: 2rpx solid #FF5722;
}

.option-label {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.option-content {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.training-feedback {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 30rpx;
}

.feedback-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.feedback-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn.next {
  background: #4CAF50;
  color: #fff;
}

.action-btn.review {
  background: #E8F5E9;
  color: #4CAF50;
}

/* 错题实验 */
.experiment-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.solution-comparison {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.solution-card {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.solution-card.wrong {
  border-left: 8rpx solid #FF5722;
}

.solution-card.correct {
  border-left: 8rpx solid #4CAF50;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.solution-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-item {
  display: flex;
  gap: 16rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.step-content {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.experiment-analysis {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.analysis-points {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.point-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.point-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #2196F3;
}

.point-content {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #2196F3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}