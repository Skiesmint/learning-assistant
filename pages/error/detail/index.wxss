/* pages/error/detail/index.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 头部样式 */
.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 通用section样式 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #2196F3;
}

/* 题目信息 */
.question-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.question-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.question-type {
  font-size: 24rpx;
  color: #2196F3;
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #E3F2FD;
  border-radius: 20rpx;
}

/* 错误分析 */
.analysis-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.analysis-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.analysis-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-label {
  font-size: 26rpx;
  color: #666;
}

.item-value {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 解题过程 */
.solution-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.solution-steps {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.step-item {
  display: flex;
  gap: 16rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #f8f8f8;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.step-content {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.solution-result {
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.result-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.result-value {
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: bold;
}

/* 复习记录 */
.review-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.review-item {
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.review-date {
  font-size: 24rpx;
  color: #999;
}

.review-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.review-status.correct {
  background: #E8F5E9;
  color: #4CAF50;
}

.review-status.wrong {
  background: #FFEBEE;
  color: #FF5722;
}

.review-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.review-note {
  margin-bottom: 16rpx;
}

.review-mistakes {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #eee;
}

.mistakes-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.mistakes-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mistake-item {
  font-size: 24rpx;
  color: #FF5722;
  padding-left: 20rpx;
  position: relative;
}

.mistake-item::before {
  content: "•";
  position: absolute;
  left: 0;
  color: #FF5722;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.action-btn.review {
  background: #2196F3;
  color: #fff;
}

.action-btn.note {
  background: #E3F2FD;
  color: #2196F3;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #2196F3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
} 