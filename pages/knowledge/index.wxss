/* pages/knowledge/index.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 知识图谱区域 */
.graph-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.knowledge-graph {
  width: 100%;
  height: 600rpx;
  margin-bottom: 30rpx;
}

.graph-legend {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-color {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
}

.legend-color.mastered {
  background: #4CAF50;
}

.legend-color.learning {
  background: #2196F3;
}

.legend-color.weak {
  background: #FFC107;
}

.legend-color.forgetting {
  background: #FF5252;
  animation: pulse 1.5s infinite;
}

/* 知识补丁包 */
.patch-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.patch-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.patch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.patch-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.patch-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.patch-status.new {
  background: #E3F2FD;
  color: #2196F3;
}

.patch-status.reviewing {
  background: #E8F5E9;
  color: #4CAF50;
}

.patch-status.completed {
  background: #F5F5F5;
  color: #9E9E9E;
}

.concept-explain {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.practice-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.practice-item {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.practice-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.practice-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.practice-answer {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.answer-label {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.answer-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.practice-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  background: #2196F3;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 遗忘预警 */
.forget-section {
  margin-bottom: 40rpx;
}

.forget-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.forget-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.forget-icon {
  font-size: 40rpx;
  color: #FF5252;
}

.forget-content {
  flex: 1;
}

.forget-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.forget-desc {
  font-size: 24rpx;
  color: #666;
}

.forget-action {
  padding: 8rpx 20rpx;
  background: #FF5252;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 遗忘预警详情 */
.forget-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.forget-action.urgent {
  background: #FF1744;
  animation: pulse 1.5s infinite;
}

/* 复习提醒 */
.reminder-section {
  margin-top: 30rpx;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reminder-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.reminder-item.high {
  border-left: 8rpx solid #FF1744;
}

.reminder-item.medium {
  border-left: 8rpx solid #FFC107;
}

.reminder-item.low {
  border-left: 8rpx solid #4CAF50;
}

.reminder-icon {
  font-size: 40rpx;
}

.reminder-content {
  flex: 1;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.reminder-time {
  font-size: 24rpx;
  color: #666;
}

.reminder-action {
  padding: 8rpx 20rpx;
  background: #2196F3;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 加载状态 */
.loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #2196F3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* 知识图谱控制按钮 */
.graph-controls {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 20rpx 0;
}

.control-btn {
  padding: 10rpx 30rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #2196F3;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.control-btn:active {
  background: #f5f5f5;
}

/* 练习相关样式 */
.practice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.practice-difficulty {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.practice-difficulty.new {
  background: #E3F2FD;
  color: #2196F3;
}

.practice-difficulty.reviewing {
  background: #E8F5E9;
  color: #4CAF50;
}

.practice-difficulty.completed {
  background: #FFF3E0;
  color: #FF9800;
}

.practice-progress {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 16rpx 0;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
}

.practice-area {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.answer-input {
  width: 100%;
  height: 80rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.answer-input[disabled] {
  background: #f0f0f0;
  color: #666;
}