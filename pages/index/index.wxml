<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="header">
      <text class="title">智引Study</text>
      <text class="subtitle">基于Deepseek的认知科学学习纠偏系统</text>
    </view>

    <view class="menu-grid">
      <view class="menu-item" wx:for="{{modules}}" wx:key="id" bindtap="navigateToModule" data-id="{{item.id}}">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</scroll-view>
